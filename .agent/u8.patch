+[[nodiscard]] UiRect IntersectRect(const UiRect& lhs, const UiRect& rhs) noexcept
+{
+    const std::uint32_t left = lhs.x > rhs.x ? lhs.x : rhs.x;
+    const std::uint32_t top = lhs.y > rhs.y ? lhs.y : rhs.y;
+    const std::uint32_t right =
