{
  "version": 6,
  "cmakeMinimumRequired": {
    "major": 3,
    "minor": 28,
    "patch": 0
  },
  "configurePresets": [
    {
      "name": "windows-common",
      "hidden": true,
      "cacheVariables": {
        "CMAKE_TOOLCHAIN_FILE": "$env{VCPKG_ROOT}/scripts/buildsystems/vcpkg.cmake",
        "TRACE2D_WARNINGS_AS_ERRORS": "ON",
        "BUILD_TESTING": "ON"
      }
    },
    {
      "name": "windows-msvc",
      "displayName": "Windows MSVC 2022 x64",
      "inherits": "windows-common",
      "generator": "Visual Studio 17 2022",
      "architecture": "x64",
      "binaryDir": "${sourceDir}/build/${presetName}"
    },
    {
      "name": "ci-windows-msvc",
      "displayName": "CI Windows MSVC v143 on Visual Studio 2026",
      "inherits": "windows-common",
      "generator": "Visual Studio 18 2026",
      "architecture": "x64",
      "toolset": "v143",
      "binaryDir": "${sourceDir}/build/${presetName}"
    },
    {
      "name": "linux-common",
      "hidden": true,
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/${presetName}",
      "cacheVariables": {
        "CMAKE_TOOLCHAIN_FILE": "$env{VCPKG_ROOT}/scripts/buildsystems/vcpkg.cmake",
        "CMAKE_BUILD_TYPE": "Debug",
        "TRACE2D_WARNINGS_AS_ERRORS": "ON",
        "TRACE2D_INSTALL_SDK": "ON",
        "BUILD_TESTING": "ON"
      }
    },
    {
      "name": "ci-linux-clang",
      "displayName": "CI Ubuntu 24.04 Clang 18 x64",
      "inherits": "linux-common",
      "cacheVariables": {
        "CMAKE_CXX_COMPILER": "clang++-18"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "windows-debug",
      "configurePreset": "windows-msvc",
      "configuration": "Debug"
    },
    {
      "name": "windows-release",
      "configurePreset": "windows-msvc",
      "configuration": "Release"
    },
    {
      "name": "ci-windows-debug",
      "configurePreset": "ci-windows-msvc",
      "configuration": "Debug"
    },
    {
      "name": "ci-linux-clang",
      "configurePreset": "ci-linux-clang"
    }
  ],
  "testPresets": [
    {
      "name": "windows-debug",
      "configurePreset": "windows-msvc",
      "configuration": "Debug",
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "ci-windows-debug",
      "configurePreset": "ci-windows-msvc",
      "configuration": "Debug",
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "ci-linux-clang",
      "configurePreset": "ci-linux-clang",
      "output": {
        "outputOnFailure": true
      }
    }
  ]
}
