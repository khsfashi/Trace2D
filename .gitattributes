# Keep benchmark contracts and fixtures byte-stable across Windows/Linux checkouts.
# B1/B2 freeze-manifest SHA-256 values are computed from LF-normalized repository bytes.
benchmarks/**/*.json text eol=lf
benchmarks/**/*.md text eol=lf
benchmarks/**/*.gd text eol=lf
benchmarks/**/*.godot text eol=lf
benchmarks/**/*.tscn text eol=lf
benchmarks/**/*.toml text eol=lf
benchmarks/**/*.cpp text eol=lf
benchmarks/**/*.hpp text eol=lf
benchmarks/**/*.txt text eol=lf

# B2 readiness provenance freezes Git blob identities for workflow/tooling files.
# Keep their checked-out bytes identical on Windows so strict blob validation does
# not mistake CRLF worktree conversion for provenance drift.
.github/workflows/*.yml text eol=lf
.github/workflows/*.yaml text eol=lf
scripts/*.py text eol=lf
