@PACKAGE_INIT@

# Resolve Trace2D-owned installed locations before loading dependency package
# configs. On CMake 3.29 and older, a nested find_dependency()/find_package()
# may change PACKAGE_PREFIX_DIR; PATH_VARS are therefore consumed while this
# package's @PACKAGE_INIT@ prefix is still authoritative.
set(Trace2D_VERSION "@PROJECT_VERSION@")
set(Trace2D_VCPKG_BASELINE "@TRACE2D_VCPKG_BASELINE@")
set_and_check(
    Trace2D_SDK_ROOT_LOCATOR
    "@PACKAGE_TRACE2D_SDK_ROOT_LOCATOR_INSTALL_PATH@"
)
set_and_check(
    Trace2D_SDK_METADATA
    "@PACKAGE_CMAKE_INSTALL_DATADIR@/Trace2D/trace2d.sdk.json"
)
set_and_check(
    Trace2D_AGENT_INDEX
    "@PACKAGE_TRACE2D_AGENT_INDEX_INSTALL_PATH@"
)
set_and_check(
    Trace2D_PUBLIC_AUTHORING_HEADER
    "@PACKAGE_CMAKE_INSTALL_INCLUDEDIR@/trace2d/Trace2D.hpp"
)
set_and_check(
    Trace2D_PUBLIC_API_INDEX
    "@PACKAGE_CMAKE_INSTALL_DATADIR@/Trace2D/docs/agent-public-api-v1.json"
)
set_and_check(
    Trace2D_PUBLIC_API_GUIDE
    "@PACKAGE_CMAKE_INSTALL_DATADIR@/Trace2D/docs/AGENT_PUBLIC_API.md"
)
set_and_check(
    Trace2D_EXTERNAL_PROJECT_GUIDE
    "@PACKAGE_CMAKE_INSTALL_DATADIR@/Trace2D/docs/EXTERNAL_PROJECT_E1.md"
)
set_and_check(
    Trace2D_CANONICAL_EXTERNAL_EXAMPLE_ROOT
    "@PACKAGE_CMAKE_INSTALL_DATADIR@/Trace2D/examples/e0_external_game"
)

# Keep the compact Agent discovery entry point visible even when the first
# downstream dependency lookup fails. The remaining package details stay on
# the successful configure path below, and QUIET consumers remain quiet.
if(NOT Trace2D_FIND_QUIETLY)
    message(STATUS "Trace2D Agent index: ${Trace2D_AGENT_INDEX}")
endif()

include(CMakeFindDependencyMacro)

# Trace2D is currently distributed as static C++ libraries. Private link
# dependencies of static archives still need imported targets to be available
# when a downstream executable links the archive.
find_dependency(box2d CONFIG REQUIRED)
find_dependency(Freetype REQUIRED)
find_dependency(SDL3 CONFIG REQUIRED)
find_dependency(SDL3_shadercross CONFIG REQUIRED)
find_dependency(nlohmann_json CONFIG REQUIRED)
find_dependency(tomlplusplus CONFIG REQUIRED)

if(NOT Trace2D_FIND_QUIETLY)
    message(STATUS "Trace2D SDK locator: ${Trace2D_SDK_ROOT_LOCATOR}")
    message(STATUS "Trace2D SDK metadata: ${Trace2D_SDK_METADATA}")
    message(STATUS "Trace2D public authoring header: ${Trace2D_PUBLIC_AUTHORING_HEADER}")
    message(STATUS "Trace2D public API index: ${Trace2D_PUBLIC_API_INDEX}")
    message(STATUS "Trace2D canonical external example: ${Trace2D_CANONICAL_EXTERNAL_EXAMPLE_ROOT}")
endif()

include("${CMAKE_CURRENT_LIST_DIR}/Trace2DTargets.cmake")
check_required_components(Trace2D)
