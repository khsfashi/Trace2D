{
  "format_version": 1,
  "artifact_kind": "trace2d-agent-index",
  "trace2d_version": "@PROJECT_VERSION@",
  "purpose": "Small deterministic routing map for ordinary installed-SDK authoring. Select only task-relevant capability/skill/surface metadata before opening larger guides, examples, headers, or tool schemas.",
  "policy": {
    "routing": "deterministic-first",
    "max_primary_surfaces": 3,
    "max_primary_skills": 2,
    "avoid_recursive_sdk_scan": true,
    "avoid_skill_body_preload": true,
    "fallback_public_api_index": "share/Trace2D/docs/agent-public-api-v1.json"
  },
  "capabilities": {
    "authority": "share/Trace2D/agent/trace2d.capabilities.toml"
  },
  "skills": {
    "registry": "share/Trace2D/agent/skills/registry-v1.json",
    "tool": "share/Trace2D/tools/trace2d_agent_skill.py",
    "guide": "share/Trace2D/docs/AGENT_SKILLS.md",
    "selection": "descriptor-first",
    "body_loading": "selected-only"
  },
  "surfaces": [
    {
      "id": "gameplay",
      "match": ["game", "gameplay", "application", "fixed-step", "lifecycle"],
      "metadata": "share/Trace2D/agent/gameplay-v1.json"
    },
    {
      "id": "scene",
      "match": ["scene", "entity", "component", "transform", "hierarchy"],
      "metadata": "share/Trace2D/agent/scene-v1.json"
    },
    {
      "id": "input",
      "match": ["input", "action", "keyboard", "gamepad", "pointer", "held", "movement"],
      "metadata": "share/Trace2D/agent/input-v1.json"
    },
    {
      "id": "ui",
      "match": ["ui", "hud", "progress", "button", "menu", "text-input"],
      "metadata": "share/Trace2D/agent/ui-v1.json"
    },
    {
      "id": "audio",
      "match": ["audio", "sound", "sfx", "music", "voice", "hit-feedback"],
      "metadata": "share/Trace2D/agent/audio-v1.json"
    }
  ]
}
