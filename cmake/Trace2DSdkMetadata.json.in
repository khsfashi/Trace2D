{
  "format_version": 1,
  "trace2d_version": "@PROJECT_VERSION@",
  "minimum_cmake_version": "3.28",
  "vcpkg_builtin_baseline": "@TRACE2D_VCPKG_BASELINE@",
  "cmake_namespace": "Trace2D::",
  "discovery": {
    "agent_index_root_relative": "trace2d.agent-index.json",
    "public_authoring_include": "trace2d/Trace2D.hpp",
    "public_api_index": "docs/agent-public-api-v1.json",
    "public_api_guide": "docs/AGENT_PUBLIC_API.md",
    "external_project_guide": "docs/EXTERNAL_PROJECT_E1.md",
    "canonical_external_example_root": "examples/e0_external_game"
  },
  "cmake_dependencies": [
    {
      "package": "box2d",
      "find_mode": "config"
    },
    {
      "package": "Freetype",
      "find_mode": "default"
    },
    {
      "package": "SDL3",
      "find_mode": "config"
    },
    {
      "package": "SDL3_shadercross",
      "find_mode": "config"
    },
    {
      "package": "nlohmann_json",
      "find_mode": "config"
    },
    {
      "package": "tomlplusplus",
      "find_mode": "config"
    }
  ],
  "consumer_build": {
    "library_linkage": "static",
    "msvc_configuration_policy": "match-installed-library-configuration"
  },
  "public_targets": [
    "Core",
    "Input",
    "Platform",
    "Runtime",
    "Scene",
    "Particles",
    "Assets",
    "Render",
    "Ui",
    "Application",
    "Agent"
  ],
  "binary_abi": "not-guaranteed"
}
