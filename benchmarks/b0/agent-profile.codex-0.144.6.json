{
  "schema_version": 1,
  "agent_id": "openai-codex-cli@0.144.6",
  "model_id": "gpt-5.6-sol",
  "model_revision": "gpt-5.6-sol",
  "settings": {
    "reasoning_effort": "high",
    "approval_policy": "never",
    "permission_profile": "trace2d_b0_isolated",
    "session_persistence": "ephemeral",
    "web_search": "disabled",
    "auth_mode": "chatgpt-managed-local",
    "provider_revision_policy": "chatgpt_managed_identifier_no_dated_snapshot"
  },
  "budget": {
    "wall_seconds": 300,
    "max_tool_calls": 80,
    "max_input_tokens": 100000,
    "max_output_tokens": 20000,
    "max_human_interventions": 0
  },
  "command": [
    "python",
    "-m",
    "benchmark_b0_codex_chatgpt_wrapper",
    "run",
    "--workspace",
    "{workspace}",
    "--prompt-file",
    "{prompt}",
    "--lane",
    "{lane}",
    "--result-file",
    "{agent_result}"
  ]
}
