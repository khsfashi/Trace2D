          }
        ]
      },
      {
        "id": "decisions-002",
        "text": "Repair remains an external Agent/user action; each repaired revision is appended and affected machine-owned verification must rerun before subjective review",
        "evidence": [
          {
            "source_type": "commit_trailer",
            "commit": "d7c7ee4599526a962d4dc5dc3e6209fc8b219991",
