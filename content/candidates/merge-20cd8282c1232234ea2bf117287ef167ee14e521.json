    "decisions": [
      {
        "id": "decisions-001",
        "text": "external games implement one source-level Game lifecycle over an engine-owned Application and canonical Runtime/Input/Scene/UI state.",
        "evidence": [
          {
            "source_type": "commit_trailer",
            "commit": "20cd8282c1232234ea2bf117287ef167ee14e521",
            "trailer": "Decision",
