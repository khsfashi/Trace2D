          }
        ]
      },
      {
        "id": "decisions-002",
        "text": "separate wall-clock scheduling from authoritative fixed stepping so external game code executes exactly once per fixed update under both headless and windowed hosts.",
        "evidence": [
          {
            "source_type": "commit_trailer",
            "commit": "20cd8282c1232234ea2bf117287ef167ee14e521",
            "trailer": "Decision",
            "ordinal": 2,
            "url": "https://github.com/khsfashi/Trace2D/commit/20cd8282c1232234ea2bf117287ef167ee14e521"
          }
        ]
      },
      {
        "id": "decisions-003",
        "text": "Application alone owns Input frame advancement; physical input is retained until the next frame after transient clear so edge semantics survive.",
        "evidence": [
          {
            "source_type": "commit_trailer",
            "commit": "20cd8282c1232234ea2bf117287ef167ee14e521",
            "trailer": "Decision",
            "ordinal": 3,
            "url": "https://github.com/khsfashi/Trace2D/commit/20cd8282c1232234ea2bf117287ef167ee14e521"
          }
        ]
      },
      {
        "id": "decisions-004",
        "text": "reuse existing WorkSpec/WorkResult/VerificationRecord and Agent inspection over canonical application-owned state instead of creating a second Agent game authority.",
        "evidence": [
          {
