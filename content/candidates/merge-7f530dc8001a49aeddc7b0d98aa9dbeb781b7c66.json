          }
        ]
      },
      {
        "id": "decisions-002",
        "text": "Exact rational speed advancement stores retained remainder and uses quotient/remainder decomposition instead of floating accumulation or unchecked delta*numerator",
        "evidence": [
          {
            "source_type": "commit_trailer",
